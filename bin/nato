#!/usr/bin/env zsh

# Based on script by EvanHahn, published into the public domain via the [unlicense](https://unlicense.org/)
# https://codeberg.org/EvanHahn/dotfiles/src/commit/f7a9d94ae2254cb7e5f67e6e5bdb74b6467f6dec/home/bin/bin/nato

declare -A NATO=(
  [a]=Alfa [b]=Bravo [c]=Charlie [d]=Delta [e]=Echo [f]=Foxtrot
  [g]=Golf [h]=Hotel [i]=India [j]=Juliett [k]=Kilo [l]=Lima
  [m]=Mike [n]=November [o]=Oscar [p]=Papa [q]=Quebec [r]=Romeo
  [s]=Sierra [t]=Tango [u]=Uniform [v]=Victor [w]=Whiskey [x]=X-ray
  [y]=Yankee [z]=Zulu
  [1]=One [2]=Two [3]=Three [4]=Four [5]=Five
  [6]=Six [7]=Seven [8]=Eight [9]=Nine [0]=Zero
)

for word in "$@"; do
  word="${(L)word}"
  out=""
  for (( i=1; i<=${#word}; i++ )); do
    char="$word[$i]"
    entry="${NATO[$char]:-$char}"
    if [ -z "$out" ]; then
      out="$entry"
    else
      out="$out $entry"
    fi
  done
  echo "$out"
done
