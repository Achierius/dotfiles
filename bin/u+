#!/usr/bin/env python3
import argparse
import unicodedata

# Based on script by EvanHahn, published into the public domain via the [unlicense](https://unlicense.org/)
# https://codeberg.org/EvanHahn/dotfiles/src/commit/f7a9d94ae2254cb7e5f67e6e5bdb74b6467f6dec/home/bin/bin/u+


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("hex_number", type=str)
    args = parser.parse_args()

    as_int = int(args.hex_number, 16)
    as_chr = chr(as_int)

    print(as_chr)
    print(unicodedata.name(as_chr))


if __name__ == "__main__":
    main()
