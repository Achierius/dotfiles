#!/usr/bin/env zsh

# Based on script by EvanHahn, published into the public domain via the [unlicense](https://unlicense.org/)
# https://codeberg.org/EvanHahn/dotfiles/src/commit/f7a9d94ae2254cb7e5f67e6e5bdb74b6467f6dec/home/bin/bin/running

set -e
set -u

process_list="$(ps -eo 'pid command')"
if [[ $# != 0 ]]; then
  process_list="$(echo "$process_list" | grep -Fiw "$@")"
fi
# Exclude kernel-ish threads
process_list_filtered="$(echo "$process_list" | awk '$2 !~ /^\[/')"

echo "$process_list_filtered" |
  grep -Fv "${0}" |
  grep -Fv grep |
  GREP_COLORS='mt=00;35' grep -E --colour=auto '^\s*[[:digit:]]+'
